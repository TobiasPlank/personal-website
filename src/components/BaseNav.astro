---
import "@/styles/navbar.css";

import sunIcon from "pixelarticons/svg/sun.svg?url";
import sunSolidIcon from "pixelarticons/svg/sun-solid.svg?url";

import moonIcon from "pixelarticons/svg/moon.svg?url";
import moonSolidIcon from "pixelarticons/svg/moon-solid.svg?url";

const links = [
    { label: "Home", href: "/"},
    { label: "About", href: "/about"},
    { label: "Projects", href: "/projects"},
    { label: "Blog", href: "/blog"}
];
---

<nav class="base-nav" aria-label="Main navigation">

    <ul class="base-nav__list">
        {
            links.map((link) => (
                <li>
                    <a href={link.href}>
                        <span>{link.label}</span>
                    </a>
                </li>
            ))
        }
    </ul>

    <button
        class="theme-toggle"
        type="button"
        aria-label="Dark mode aktivieren"
        aria-pressed="false"
    >
    <span class="theme-icon-set theme-icon-set--sun">
        <span
            class="theme-icon theme-icon--regular"
            style={`--icon-url: url("${sunIcon}")`}
            aria-hidden="true"
        ></span>

        <span
            class="theme-icon theme-icon--solid"
            style={`--icon-url: url("${sunSolidIcon}")`}
            aria-hidden="true"
        ></span>
    </span>

        <span class="theme-icon-set theme-icon-set--moon">
        <span
            class="theme-icon theme-icon--regular"
            style={`--icon-url: url("${moonIcon}")`}
            aria-hidden="true"
        ></span>

        <span
            class="theme-icon theme-icon--solid"
            style={`--icon-url: url("${moonSolidIcon}")`}
            aria-hidden="true"
        ></span>
    </span>
    </button>
</nav>

<script>
    const button = document.querySelector<HTMLButtonElement>(".theme-toggle");

    const savedTheme =
        localStorage.getItem("theme") === "light" ? "light" : "dark";

    document.documentElement.dataset.theme = savedTheme;

    button?.setAttribute("aria-pressed", String(savedTheme === "dark"));
    button?.setAttribute(
        "aria-label",
        savedTheme === "dark"
            ? "Light mode aktivieren"
            : "Dark mode aktivieren",
    );

    button?.addEventListener("click", () => {
        const isDark = document.documentElement.dataset.theme === "dark";
        const nextTheme = isDark ? "light" : "dark";

        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem("theme", nextTheme);

        button.setAttribute("aria-pressed", String(nextTheme === "dark"));
        button.setAttribute(
            "aria-label",
            nextTheme === "dark"
                ? "Light mode aktivieren"
                : "Dark mode aktivieren",
        );
    });
</script>
